# Paste these settings into the Dokploy Compose service's Environment tab.
# For a local container test, copy this file to .env (never commit .env).
# Generate an admin token with: openssl rand -hex 32
# Leave empty to keep admin endpoints disabled.
ADMIN_TOKEN=

# Public legal-page details. Passed to Vite during the Docker build.
# Changes require a rebuild, not just a container restart.
# Dokploy is the deployment platform; specify your actual server provider below.
VITE_LEGAL_PROVIDER_NAME="[Full legal name or company name]"
VITE_LEGAL_PROVIDER_ADDRESS="[Street and house number, ZIP city, country]"
VITE_LEGAL_PROVIDER_EMAIL="[contact email address]"
VITE_LEGAL_REPRESENTED_BY="[Representative, if applicable]"
VITE_LEGAL_VAT_ID="[VAT identification number, if applicable]"
VITE_LEGAL_CONTENT_RESPONSIBLE="[name and address, if applicable]"
VITE_LEGAL_DPO="[Data protection officer contact details, if legally required]"
VITE_LEGAL_HOSTING_PROVIDER="[hosting provider name and contact details]"
VITE_LEGAL_HOSTING_REGION="[hosting region/country]"
VITE_LEGAL_HOSTING_DPA="[data processing agreement status]"
VITE_LEGAL_LOG_RETENTION="[technical log retention period]"
VITE_LEGAL_ACCOUNT_RETENTION="[guest account and match statistic retention period]"

# Optional rate-limit overrides; the Compose file supplies defaults.
# HTTP_REQUESTS_PER_MINUTE=240
# GUEST_LOGINS_PER_HOUR=12
# ADMIN_REQUESTS_PER_MINUTE=60
# WS_CONNECTS_PER_MINUTE=30
# MAX_WS_PER_IP=20
# WS_MESSAGES_PER_10S=120
# QUEUE_ACTIONS_PER_MINUTE=12
# FIRE_ACTIONS_PER_10S=120
# MAX_WS_PAYLOAD_BYTES=4096
